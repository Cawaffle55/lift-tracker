              "name": "Face Pull",
              "warmupSets": 0,
              "workingSets": 3,
              "reps": "12-15",
              "rpe": "8",
              "technique": "",
              "rest": "60s",
              "notes": "Pull toward the forehead, rotate out.",
              "substitutions": [
                "Reverse Pec Deck"
              ]
