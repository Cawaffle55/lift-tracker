    {
      "name": "Week 1",
      "notes": "Moderate effort.",
      "days": [
        {
          "name": "Push",
          "notes": "Chest, shoulders, triceps.",
          "exercises": [
            {
              "name": "Barbell Bench Press",
              "warmupSets": 2,
              "workingSets": 3,
              "reps": "6-8",
              "rpe": "7-8",
              "technique": "",
              "rest": "2-3 min",
              "notes": "Shoulder blades pinned, controlled descent.",
              "substitutions": [
                "Dumbbell Bench Press",
                "Machine Chest Press"
              ]
            },
            {
              "name": "Seated Dumbbell Shoulder Press",
              "warmupSets": 1,
              "workingSets": 3,
              "reps": "8-10",
              "rpe": "7-8",
              "technique": "",
              "rest": "2 min",
              "notes": "Stop just short of lockout.",
              "substitutions": [
                "Machine Shoulder Press",
                "Standing Barbell Press"
              ]
            },
            {
              "name": "Cable Chest Fly",
              "warmupSets": 0,
              "workingSets": 3,
              "reps": "10-12",
              "rpe": "8",
              "technique": "",
              "rest": "90s",
              "notes": "Stretch at the bottom, squeeze at the top.",
              "substitutions": [
                "Pec Deck",
                "Dumbbell Fly"
              ]
            },
            {
              "name": "Dumbbell Lateral Raise",
              "warmupSets": 0,
              "workingSets": 3,
              "reps": "12-15",
              "rpe": "8-9",
              "technique": "",
              "rest": "60s",
              "notes": "Lead with the elbows.",
              "substitutions": [
                "Cable Lateral Raise"
              ]
            },
            {
              "name": "Triceps Rope Pushdown",
              "warmupSets": 0,
              "workingSets": 3,
              "reps": "10-12",
              "rpe": "8-9",
              "technique": "",
              "rest": "60s",
              "notes": "Keep elbows tucked.",
              "substitutions": [
                "Overhead Cable Extension",
                "Dips"
              ]
            }
          ]
        },
        {
          "name": "Pull",
